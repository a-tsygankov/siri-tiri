{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Siri-Tiri event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "eventId",
    "sourceId",
    "createdAt",
    "type"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "capture",
        "review",
        "analysis",
        "heartbeat",
        "update_status"
      ]
    },
    "payload": {
      "type": "object"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
